-- 5. ROOM SCANNER & SPATIAL CLUSTERING ENGINE
-- ========================================================================
local ROOM_ORDER = {"room1", "room2", "room3", "room4", "room5", "room6", "room7", "bossRoom"}
local BOSS_ROOMS = {room2 = true, room4 = true, bossRoom = true}
local BOSS_NAMES = {
    ["Midgardian Champion"] = true,
    ["Bob The Frost Giant"] = true,
    ["Odin"] = true,
    ["Rødin"] = true,
    ["Odin Reincarnation"] = true
}

local PACK_CLUSTER_THRESHOLD = 35

local function checkAutoStart()
    local started = Workspace:FindFirstChild("dungeonStarted")
    if started and not started.Value then
        local remotes = ReplicatedStorage:FindFirstChild("remotes")
        if remotes and remotes:FindFirstChild("changeStartValue") then
            remotes.changeStartValue:FireServer()
        end
    end
end

local function getTargetCluster(myPos)
    local dung = Workspace:FindFirstChild("dungeon")
    if not dung then return nil end

    for _, rName in ipairs(ROOM_ORDER) do
        local r = dung:FindFirstChild(rName)
        if r and r:FindFirstChild("enemyFolder") then
            local isBossZone = BOSS_ROOMS[rName] or false
            local aliveMobs = {}

            for _, m in ipairs(r.enemyFolder:GetChildren()) do
                if m:IsA("Model") then
                    local hum = m:FindFirstChildOfClass("Humanoid")
                    local hrp = m:FindFirstChild("HumanoidRootPart") or m:FindFirstChild("Torso")
                    if hum and hrp and hum.Health > 0 then
                        table.insert(aliveMobs, {model = m, hrp = hrp, hum = hum, name = m.Name, pos = hrp.Position})
                    end
                end
            end

            if #aliveMobs > 0 then
                if isBossZone or BOSS_NAMES[aliveMobs[1].name] then
                    local boss = aliveMobs[1]
                    local d = (boss.pos - myPos).Magnitude
                    return {
                        isBoss = true,
                        room = rName,
                        name = boss.name,
                        model = boss.model,
                        hrp = boss.hrp,
                        hum = boss.hum,
                        dist = d,
                        minDist = d,
                        centerPos = boss.pos
                    }
                else
                    local n = #aliveMobs
                    local adj = {}
                    for i = 1, n do adj[i] = {} end
                    for i = 1, n do
                        for j = i + 1, n do
                            local pA = aliveMobs[i].pos
                            local pB = aliveMobs[j].pos
                            local dx = pA.X - pB.X
                            local dz = pA.Z - pB.Z
                            if (dx * dx + dz * dz) <= (PACK_CLUSTER_THRESHOLD * PACK_CLUSTER_THRESHOLD) then
                                table.insert(adj[i], j)
                                table.insert(adj[j], i)
                            end
                        end
                    end

                    local visited = {}
                    local packs = {}
                    for i = 1, n do
                        if not visited[i] then
                            local packMobs = {}
                            local stack = {i}
                            visited[i] = true
                            while #stack > 0 do
                                local curr = table.remove(stack)
                                table.insert(packMobs, aliveMobs[curr])
                                for _, neighbor in ipairs(adj[curr]) do
                                    if not visited[neighbor] then
                                        visited[neighbor] = true
                                        table.insert(stack, neighbor)
                                    end
                                end
                            end
                            table.insert(packs, packMobs)
                        end
                    end

                    local bestPack = nil
                    local bestDist = 999999
                    for _, pkm in ipairs(packs) do
                        local cx, cy, cz = 0, 0, 0
                        local minD = 999999
                        for _, m in ipairs(pkm) do
                            cx = cx + m.pos.X
                            cy = cy + m.pos.Y
                            cz = cz + m.pos.Z
                            local d = (m.pos - myPos).Magnitude
                            if d < minD then minD = d end
                        end
                        local centroid = Vector3.new(cx / #pkm, cy / #pkm, cz / #pkm)
                        local cDist = (centroid - myPos).Magnitude
                        if cDist < bestDist then
                            bestDist = cDist
                            bestPack = {
                                isBoss = false,
                                room = rName,
                                count = #pkm,
                                mobs = pkm,
                                centerPos = centroid,
                                minDist = minD,
                                dist = cDist
                            }
                        end
                    end
                    return bestPack
                end
            end
        end
    end
    return nil
end

