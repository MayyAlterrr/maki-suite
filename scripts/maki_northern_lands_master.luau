-- 1. LOAD HIGHWAY WAYPOINTS (1,144 Points from Spawn to Odin)
-- ========================================================================
local GITHUB_PATH_URL = "https://raw.githubusercontent.com/MayyAlterrr/maki-suite/main/paths/dqr_highway_northern_lands.json"
local waypoints = {}

local function parseWaypoints(raw)
    local ok, parsed = pcall(function() return HttpService:JSONDecode(raw) end)
    if ok and parsed and parsed.points then
        for _, pt in ipairs(parsed.points) do
            table.insert(waypoints, Vector3.new(pt.x, pt.y, pt.z))
        end
    end
end

if #waypoints == 0 then
    pcall(function()
        if typeof(isfile) == "function" and isfile("dqr_highway_northern_lands.json") then
            local raw = readfile("dqr_highway_northern_lands.json")
            parseWaypoints(raw)
            if #waypoints > 0 then
                print(string.format("[NL Master] Tier 1 (Local): Loaded %d waypoints", #waypoints))
            end
        end
    end)
end

if #waypoints == 0 then
    pcall(function()
        print("[NL Master] Tier 2 (GitHub): Fetching highway waypoints...")
        local raw = game:HttpGet(GITHUB_PATH_URL)
        parseWaypoints(raw)
        if #waypoints > 0 then
            print(string.format("[NL Master] Tier 2 (GitHub): Loaded %d waypoints", #waypoints))
            pcall(function()
                if typeof(writefile) == "function" then
                    writefile("dqr_highway_northern_lands.json", raw)
                end
            end)
        end
    end)
end

