local totalWps = #waypoints
print(string.format("[NL Master] Initialized with %d highway waypoints!", totalWps))

local function findClosestWaypointIndex(pos, startIdx, endIdx)
    if totalWps == 0 then return 1 end
    startIdx = math.clamp(startIdx or 1, 1, totalWps)
    endIdx = math.clamp(endIdx or totalWps, startIdx, totalWps)

    local bestIdx = startIdx
    local bestDist = 999999
    for i = startIdx, endIdx do
        local wp = waypoints[i]
        if wp then
            local d = (wp - pos).Magnitude
            if d < bestDist then
                bestDist = d
                bestIdx = i
            end
        end
    end
    return bestIdx
end

