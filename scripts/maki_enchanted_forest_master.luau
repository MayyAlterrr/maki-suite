        toggleBtn.BackgroundColor3 = Color3.fromRGB(30, 140, 70)
        toggleBtn.Text = "[ AUTO-FARM: RUNNING ]"
    else
        toggleBtn.BackgroundColor3 = Color3.fromRGB(160, 40, 40)
        toggleBtn.Text = "[ AUTO-FARM: PAUSED ]"
